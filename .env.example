# ==========================================================================
# EaseTrading environment template.
# Copy this file to ".env" and fill in the values. NEVER commit the real .env
# (it is git-ignored). Secrets live ONLY in .env.
# ==========================================================================

# ---- Database ----
# The api keeps its own data (watchlist, alerts, history) in ONE
# SQLite file — no database server needed. Default: apps/api/easetrading.db
# DB_PATH=easetrading.db

# ---- Security ----
# Secret used to sign JWT login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Google sign-in: the OAuth "Web application" Client ID from Google Cloud Console
# (not the client secret). Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
# Encrypts each user's saved Groww key + secret. Generate once: openssl rand -base64 32
# Keep it: changing it makes saved keys unreadable (users must enter them again).
CREDENTIAL_AES_KEY=

# ---- Broker (where prices, the stock list and your portfolio come from) ----
# "mock"  = simulated data, no credentials needed (default, great for dev)
# "groww" = your real Groww account via the Groww Trade API (read-only until phase G5)
BROKER_PROVIDER=mock

# ---- Groww Trade API (only needed when BROKER_PROVIDER=groww) ----
# How to log in:
#   approval = API key + API secret. Approve the key once a day on Groww's API-keys page.
#   totp     = API key + TOTP secret (base32 code from "Generate TOTP token").
#   token    = paste the daily access token into GROWW_ACCESS_TOKEN (expires 6:00 AM daily).
GROWW_AUTH_MODE=approval
# Wrap values in SINGLE quotes — secrets can contain $ * @ ) which docker compose
# would otherwise try to interpret.  Example:  GROWW_API_SECRET='abc$123'
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=
GROWW_ACCESS_TOKEN=

# ---- Analysis service ----
# IMPORTANT: do NOT set ANTHROPIC_API_KEY here (it would switch AI billing to the paid API).
ANALYSIS_SERVICE_URL=http://localhost:8000
# "mock" = fake fundamentals (offline dev). "auto" = real Yahoo + NSE/BSE with fallback.
FUNDAMENTALS_MODE=mock

